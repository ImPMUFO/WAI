# Environment example — DO NOT COMMIT REAL KEYS
# Copy this file to .env.local and fill in real values locally (never commit .env.local)

# Deepseek / AI service
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.example/v1/query

# Optional (if you use Anthropic as fallback)
ANTHROPIC_API_KEY=

# Next.js settings
NEXT_PUBLIC_BASE_URL=http://localhost:3000

